# Template for local release signing configuration.
# Copy this file to `keystore.properties` (which is git-ignored) and fill in
# real values, OR provide the signing config via the environment variables
# KEYSTORE_FILE, KEYSTORE_PASSWORD, KEY_ALIAS and KEY_PASSWORD (used in CI).
#
# NEVER commit keystore.properties or the .jks/.keystore file itself.
storeFile=path/to/your-release.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
